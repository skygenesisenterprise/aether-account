# Cloud / Dokploy
DOMAIN_HOST=
APP_IMAGE_TAG=cloud
DATABASE_URL=
PRISMA_SCHEMA_DEPLOY=true
PRISMA_SCHEMA_DEPLOY_STRATEGY=push
ALLOW_MIGRATION_FAILURE=false

# Local dev reverse proxy
DEV_HTTP_BIND_HOST=0.0.0.0
DEV_HTTP_PORT=80

# Database
PG_USER=postgres
PG_PASS=postgres
PG_DB=postgres

# Auth
JWT_SECRET=replace-me
JWT_ISSUER=aether-account
NEXT_PUBLIC_API_URL=/api/v1
EXPO_PUBLIC_API_URL=http://account.skygenesisenterprise.localhost/api/v1
NEXT_PUBLIC_REALTIME_URL=/api/v1/realtime/ws
API_INTERNAL_URL=http://server:8080/api/v1
NEXT_PUBLIC_USE_PLATFORM_MOCKS=false

# Logging
LOG_LEVEL=info
HTTP_ACCESS_LOGS=false
API_ACCESS_LOGS=false
WORKER_WAIT_FOR_DB=false

# Redis
REDIS_ENABLED=true
REDIS_REQUIRED=true
REDIS_PASSWORD=
REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379/0
REDIS_KEY_PREFIX=aether-meet:v1
REDIS_DEFAULT_TTL=300
REDIS_CONNECT_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_MAX_RETRIES=3